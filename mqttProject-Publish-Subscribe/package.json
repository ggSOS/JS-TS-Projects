{
  "name": "exercicio-mqtt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n broker,server,sensor,vite -c blue,green,yellow,magenta \"npm run broker\" \"npm run server\" \"npm run sensor\" \"npm run vite\"",
    "broker": "npx tsx broker.ts",
    "server": "npx tsx server.ts",
    "sensor": "npx tsx sensor.ts",
    "vite": "vite",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "aedes": "^0.51.3",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "mqtt": "^5.10.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
